APP_NAME="Brewtech"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.vercel.app

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ================================================================
# Database Configuration (Remote / Cloud DB for Vercel)
# ================================================================
# Contoh PostgreSQL (Supabase / Neon / Render):
# DB_CONNECTION=pgsql
# DB_HOST=ep-xxxx.neon.tech
# DB_PORT=5432
# DB_DATABASE=neondb
# DB_USERNAME=neondb_owner
# DB_PASSWORD=your_password
# DB_SSLMODE=require
# ATAU gunakan DATABASE_URL:
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
#
# Contoh MySQL (TiDB Cloud / Aiven / Railway):
# DB_CONNECTION=mysql
# DB_HOST=gateway01.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_DATABASE=brewtech
# DB_USERNAME=xxxx.root
# DB_PASSWORD=your_password

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=brewtech_v2
DB_USERNAME=root
DB_PASSWORD=

# Session & Cache (Driver Cookie & Array cocok untuk Vercel Serverless)
BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

# Token rahasia untuk trigger migrasi via browser:
# https://<domain-anda>.vercel.app/artisan/migrate?token=brewtech_secure_migrate_key_2026&seed=1
MIGRATE_SECRET_KEY=brewtech_secure_migrate_key_2026

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@brewtech.id"
MAIL_FROM_NAME="${APP_NAME}"
