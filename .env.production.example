APP_NAME="Brewtech"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.vercel.app

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ================================================================
# Database Configuration (Supabase PostgreSQL for Vercel)
# ================================================================
# Dapatkan kredensial di Supabase: Project Settings -> Database -> Connection Parameters
# Jika menggunakan Connection Pooler (Disarankan untuk Serverless Vercel):
# - Host: aws-0-[REGION].pooler.supabase.com
# - Port: 6543 (Transaction Mode) atau 5432 (Session Mode)
# - User: postgres.[PROJECT_REF]
# - Database: postgres
# ================================================================
DB_CONNECTION=pgsql
DB_HOST=aws-0-eu-west-2.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.rolcvsfnpjtrtbfgiguw
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
DB_SSLMODE=require

# Alternatif menggunakan single DATABASE_URL:
# DATABASE_URL=postgres://postgres.rolcvsfnpjtrtbfgiguw:YOUR_SUPABASE_DB_PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?sslmode=require

# Session & Cache (Driver Cookie & Array cocok untuk Vercel Serverless)
BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

# Token rahasia untuk trigger migrasi Supabase via browser di Vercel:
# https://<domain-anda>.vercel.app/artisan/migrate?token=brewtech_secure_migrate_key_2026&seed=1
MIGRATE_SECRET_KEY=brewtech_secure_migrate_key_2026

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@brewtech.id"
MAIL_FROM_NAME="${APP_NAME}"
